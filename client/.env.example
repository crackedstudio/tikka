# Tikka client Vite environment. See ../docs/env/client.md.
# Values are bundled into public browser assets. Never put server secrets here.
VITE_API_BASE_URL=http://localhost:3001
VITE_ADMIN_TOKEN=

VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_RAFFLE_CONTRACT_ADDRESS=
VITE_CONTRACT_DEPLOYMENT_HASH=

# Required by scripts/validate-env.js for Supabase-backed metadata.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_TABLE=raffle_metadata

VITE_DEFAULT_WALLET=freighter
VITE_WALLET_AUTO_CONNECT=false
VITE_APP_ENV=development
VITE_DEBUG_MODE=true
VITE_DEBUG=false
VITE_API_TIMEOUT=30000

# ============================================
# IPFS CONFIGURATION (Optional - Future Use)
# IPFS Gateway URL for image storage
# Example: https://ipfs.io/ipfs/
VITE_IPFS_GATEWAY=
# Pinata API Key (if using Pinata for IPFS)
VITE_PINATA_API_KEY=
# Pinata Secret Key
VITE_PINATA_SECRET_KEY=
# ANALYTICS & MONITORING (Optional)
# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=
# Sentry DSN for error tracking. Leave blank to disable client error reporting
# entirely (no events are sent and the Sentry chunk is never fetched).
VITE_SENTRY_DSN=
# Client error-telemetry sampling, 0–1. Errors default to 0.25, traces to 0.05,
# to keep ingest volume (and cost) low.
VITE_SENTRY_SAMPLE_RATE=0.25
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# Optional explicit Sentry environment tag (falls back to VITE_APP_ENV).
VITE_SENTRY_ENVIRONMENT=
# FEATURE FLAGS (Optional)
# Enable/disable specific features during development
||||||| MERGE_BASE
# Sentry DSN for error tracking
VITE_FEATURE_LEADERBOARD=true
VITE_FEATURE_SOCIAL_SHARE=true
VITE_FEATURE_EMAIL_NOTIFICATIONS=false
VITE_USE_DEMO_DATA=true
VITE_SHOW_DEV_TOOLS=true
VITE_TEST_MODE=false
