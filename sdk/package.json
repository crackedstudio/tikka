{
  "name": "@tikka/sdk",
  "version": "0.1.0",
  "description": "NestJS SDK for Tikka Soroban contract interaction",
  "private": true,
  "license": "Apache-2.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./read": {
      "import": {
        "types": "./dist/esm/read/index.read.d.ts",
        "default": "./dist/esm/read/index.read.js"
      },
      "require": {
        "types": "./dist/cjs/read/index.read.d.ts",
        "default": "./dist/cjs/read/index.read.js"
      }
    },
    "./write": {
      "import": {
        "types": "./dist/esm/write/index.write.d.ts",
        "default": "./dist/esm/write/index.write.js"
      },
      "require": {
        "types": "./dist/cjs/write/index.write.d.ts",
        "default": "./dist/cjs/write/index.write.js"
      }
    },
    "./light": {
      "import": {
        "types": "./dist/esm/light.d.ts",
        "default": "./dist/esm/light.js"
      },
      "require": {
        "types": "./dist/cjs/light.d.ts",
        "default": "./dist/cjs/light.js"
      }
    }
  },
  "bin": {
    "tikka": "./bin/tikka.cjs"
  },
  "scripts": {
    "cli": "node bin/tikka.cjs",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.build.json",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
    "build:read": "tsc -p tsconfig.read.json",
    "build:light": "tsc -p tsconfig.light.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --config jest.config.cjs",
    "tikka": "node bin/tikka.mjs",
    "examples:check": "tsc --project examples/tsconfig.json",
    "example:cli": "node bin/tikka.mjs",
    "example:quickstart": "ts-node examples/quickstart.ts",
    "example:create-raffle": "ts-node examples/create-raffle.ts",
    "example:buy-tickets": "ts-node examples/buy-tickets.ts",
    "example:listen-events": "ts-node examples/listen-events.ts",
    "example:offline-signing": "ts-node examples/offline-signing.ts",
    "example:custom-wallet": "ts-node examples/custom-wallet.ts",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "size-check": "size-limit",
    "analyze:light": "node scripts/bundle-analysis/analyze.mjs",
    "size-check:legacy": "powershell (Get-Item dist/light/index.light.js).Length"
  },
  "size-limit": [
    {
      "name": "@tikka/sdk/read",
      "path": "dist/cjs/read/index.read.js",
      "limit": "50 Kb",
      "gzip": true,
      "ignore": [@nestjs/common", "@nestjs/core", "@stellar/stellar-sdk", "rxjs", "reflect-metadata", "bignumber.js"]
    },
    {
      "name": "@tikka/sdk light",
      "path": "dist/cjs/light.js",
      "limit": "25 Kb",
      "gzip": true,
      "ignore": ["@nestjs/common", "@nestjs/core", "@stellar/stellar-sdk", "rxjs", "reflect-metadata", "bignumber.js"]
    }
  ],
  "dependencies": {
    "@albedo-link/intent": "^0.13.0",
    "@lobstrco/signer-extension-api": "^2.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@stellar/freighter-api": "^3.1.0",
    "@stellar/stellar-sdk": "^16.1.0",
    "bignumber.js": "^11.1.4",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^14.0.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^10.4.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint-plugin": "^8.56.1",
    "@typescript-parser": "^8.56.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.2",
    "fast-check": "^4.7.0",
    "jest": "^30.4.2",
    "size-limit": "^11.1.6",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "4.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37bf2531"
  }
}