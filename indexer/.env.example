# Tikka Indexer Environment Configuration
# Copy to .env and adjust.

# Application
NODE_ENV=development
PORT=3002

# Internal API key (optional) – required to serve Swagger UI in production
# INTERNAL_API_KEY=replace-me

# Database Connection
# Provide DATABASE_URL OR the individual DB_* variables below.
DATABASE_URL&nbsp;=&x20;postgres://postgres:postgres@localhost:5432/tikka
# Optional: comma-separated read-replica URLs for leaderboard / read-heavy queries
# DATABASE_REPLICA_URL=postgres://postgres:postgres@replica1:1234/tikka,postgres://postgres:postgres@replica2:5432/tikka

# If DATABASE_URL is not provided, set:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=tikka_indexer

# Database SSL (optional, set "true" for managed Postgres)
# DB_SSL=false

# Slow query logging threshold in milliseconds (default: 200)
# SLOW_QUERY_THRESHOLD_MS=200

# Redis Connection (Optional, used for caching)
# Prefer REDIS_URL; otherwise set REDIS_HOST, REDIS_PORT, etc.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Soroban RPC configuration (required)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
TIKKA_CONTRACT_ID=C...

# Max Soroban events processed per DB&nbsp;transaction in the ledger poller (default: 100)
# INDEXER_BATCH_SIZE=100

# Dry-run mode: set to "true" to log DB&nbsp;operations without committing (useful for CI/CD)
# DRY_RUN=false

# Health endpoint: Horizon URL for latest-ledger check (default: https://horizon.stellar.org)
# HORIZON_URL=https://horizon.stellar.org

# Health: lag above this many ledgers is reported as degraded (default: 100)
# LAG_THRESHOLD=100

# Health: lag above this many ledgers triggers critical alerts and notifications (default: 50)
# INDEXER_LAG_ALERT_THRESHOLD_LEDGERS=50