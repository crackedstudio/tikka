# Tikka Indexer environment. See ../docs/env/indexer.md.
NODE_ENV=development
PORT=3002

# Required. Set DATABASE_URL or the complete DB_* connection below.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
TIKKA_CONTRACT_ID=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tikka_indexer
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=tikka_indexer

# Optional service configuration
INTERNAL_API_KEY=
DATABASE_REPLICA_URL=
DB_SSL=false
SLOW_QUERY_THRESHOLD_MS=200
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
HORIZON_URL=https://horizon.stellar.org
LAG_THRESHOLD=100
INDEXER_LAG_ALERT_THRESHOLD_LEDGERS=50
INDEXER_BATCH_SIZE=100
DRY_RUN=true
MAX_DISPATCH_RETRIES=3
BASE_RETRY_DELAY_MS=500
SHUTDOWN_TIMEOUT_MS=15000
RAFFLE_EVENTS_RETENTION_DAYS=90
BATCH_SIZE=1000
MAX_BATCH=
RESUME=true
CONFIRM_DELETE=

# Optional OpenTelemetry tracing
OTEL_SERVICE_NAME=tikka-indexer
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_CONSOLE=false