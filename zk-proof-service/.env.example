# ─────────────────────────────────────────────────────────────────────────────
# zk-proof-service environment configuration
# Copy this file to .env and fill in the values before starting the service.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service ──────────────────────────────────────────────────────────────────

# Host and port the HTTP service binds to.
ZK_SERVICE_HOST=127.0.0.1
ZK_SERVICE_PORT=3010

# ── Artifact paths ───────────────────────────────────────────────────────────
# Paths to the trusted setup ceremony output files.
# These files must exist and pass integrity checks before the service starts.

# Powers of Tau phase 1 output (hermez perpetual powers of tau or your own ceremony).
# Download: https://github.com/iden3/snarkjs#7-prepare-phase-2
PTAU_FILE_PATH=./artifacts/pot18_final.ptau

# Phase 2 proving key — specific to your circuit.
ZKEY_FILE_PATH=./artifacts/circuit_final.zkey

# Verification key exported from the .zkey (used for on-chain / server-side verify).
VKEY_FILE_PATH=./artifacts/vkey.json

# ── Ceremony checksums ───────────────────────────────────────────────────────
# SHA-256 hex digests of each artifact, taken from the published ceremony
# transcript.  The service will REFUSE TO START if the computed digest does not
# match the value set here.
#
# How to obtain these values:
#   Powers of Tau: https://github.com/iden3/snarkjs#powers-of-tau
#                  The hermez perpetual ceremony publishes hashes at
#                  https://github.com/iden3/snarkjs/blob/master/CONTRIBUTING.md
#   zkey / vkey:   Your project's ceremony coordinator should publish these
#                  alongside the contribution transcript.
#
# Example (replace with real values from the ceremony):
# EXPECTED_PTAU_CHECKSUM=0102030405060708...
# EXPECTED_ZKEY_CHECKSUM=aabbccddee112233...
# EXPECTED_VKEY_CHECKSUM=ffeeddccbb998877...

EXPECTED_PTAU_CHECKSUM=
EXPECTED_ZKEY_CHECKSUM=
EXPECTED_VKEY_CHECKSUM=

# ── Optional: snarkjs structural verification ────────────────────────────────
# When set to "true", the service also calls snarkjs.zKey.verifyFromInit() to
# validate the full phase-2 contribution chain before startup.
# This is slower (~seconds on large circuits) but provides a stronger guarantee
# that the .zkey was honestly derived from the .ptau file.
ZKEY_STRUCTURAL_VERIFY=false
