# Tikka Oracle environment. See ../docs/env/oracle.md.
PORT=3003
NODE_ENV=development

# Stellar network and contract
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_FALLBACK_URLS=
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RAFFLE_CONTRACT_ID=

# Select env, aws-kms, or gcp-kms. Supply credentials for the selected provider.
KEY_PROVIDER=env
ORACLE_SECRET_KEY=
ORACLE_PRIVATE_KEY=
# AWS_REGION=
# AWS_KMS_KEY_ID=
# GCP_PROJECT_ID=
# GCP_LOCATION_ID=global
# GCP_KEY_RING_ID=
# GCP_KEY_ID=
# GCP_KEY_VERSION=1

# Redis queue and retries
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_MAX_RETRIES=3
QUEUE_INITIAL_BACKOFF_MS=2000
QUEUE_BACKOFF_MULTIPLIER=2
QUEUE_MAX_BACKOFF_MS=60000
QUEUE_CONFIRMATION_TIMEOUT_MS=300000
QUEUE_MAX_CONCURRENCY=5
QUEUE_GENERATION_TIMEOUT_MS=30000
QUEUE_SUBMISSION_TIMEOUT_MS=120000

# Randomness, circuit breaker, priority, and fees
VRF_THRESHOLD_XLM=500
ORACLE_CB_FAILURE_THRESHOLD=5
ORACLE_CB_RESET_TIMEOUT_MS=60000
ORACLE_HIGH_VALUE_THRESHOLD_XLM=10000
ORACLE_MED_VALUE_THRESHOLD_XLM=1000
ORACLE_MAX_FEE_STROOPS=100000000
ORACLE_MIN_FEE_STROOPS=100
LOW_STAKES_THRESHOLD_XLM=500
TX_SUBMIT_MAX_ATTEMPTS=5
TX_SUBMIT_INITIAL_BACKOFF_MS=1000
TX_SUBMIT_ALERT_WEBHOOK_URL=

# Multi-oracle mode
ORACLE_MODE=single
MULTI_ORACLE_ENABLED=false
LOCAL_ORACLE_ID=
ORACLE_REGISTRY=
ORACLE_PEERS=
ORACLE_SECRETS=
MULTI_ORACLE_THRESHOLD=
ORACLE_MULTI_TIMEOUT_MS=10000

# Optional Supabase and alerting
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
ALERTING_PROVIDER=none
PAGERDUTY_ROUTING_KEY=
OPSGENIE_API_KEY=
ALERT_WEBHOOK_URL=

# Heartbeat and event listener
HEARTBEAT_INTERVAL_MS=3600000
HEARTBEAT_ALERT_TIMEOUT_MS=90000
EVENT_LISTENER_INITIAL_RETRY_DELAY=1000
EVENT_LISTENER_MAX_RETRY_DELAY=60000
ORACLE_DRAW_REQUEST_REPLAY=false

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
LOG_TO_CONSOLE=true
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_ZIPPED_ARCHIVE=true

# Optional operator key-age verification
ORACLE_KEY_CREATED_AT=
ORACLE_KEY_MAX_AGE_DAYS=90
